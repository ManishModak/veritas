{"evidence":{"id":"E1","kind":"fact","text":"revenue for fiscal year ending 2015-01-25 = $4,681.5M (XBRL tag Revenues)","source":"10-K accession 0001045810-15-000036, filed 2015-03-12"},"origins":{"queries":[{"sql":"SELECT * FROM veritas_pg.facts WHERE cik = 1045810 ORDER BY fy_end, CASE concept WHEN 'revenue' THEN 0 WHEN 'cogs' THEN 1 WHEN 'sga' THEN 2 WHEN 'depreciation' THEN 3 WHEN 'net_income' THEN 4 WHEN 'cfo' THEN 5 WHEN 'receivables' THEN 6 WHEN 'current_assets' THEN 7 WHEN 'ppe' THEN 8 WHEN 'assets' THEN 9 WHEN 'current_liabilities' THEN 10 WHEN 'lt_debt' THEN 11 ELSE 99 END","rows":[{"cik":"1045810","company":"Nvidia","fy_end":"2015-01-25","concept":"revenue","tag":"Revenues","value":"4681507000","accn":"0001045810-15-000036","filed":"2015-03-12"}],"mode":"zetaris","label":"executed on Zetaris","table":"facts"}],"rows":[{"cik":"1045810","company":"Nvidia","fy_end":"2015-01-25","concept":"revenue","tag":"Revenues","value":"4681507000","accn":"0001045810-15-000036","filed":"2015-03-12"}]},"company":{"attrs":{"cik":1045810,"company":"Nvidia","fy_end":"2016-01-31","activeRevision":"a8ff0e701965","liveRevision":""}},"filings":[{"attrs":{"accn":"0001045810-15-000036","filed":"2015-03-12","cik":1045810,"company":"Nvidia","url":"https://www.sec.gov/Archives/edgar/data/1045810/000104581015000036/0001045810-15-000036-index.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1045810_2016-01-31","revisionId":"a8ff0e701965","sampleIndex":0,"findingIndex":0,"management_says":"Revenue growth driven by new product releases (GeForce GTX TITAN X, GTX 980 Ti, GTX 950, VR products) and doubled GeForce Experience users.","numbers_show":"Quarterly revenue growth accelerated through the year: Q1 +4.4%, Q2 +4.5%, Q3 +6.5%, Q4 +12.0% year-over-year, consistent with new product ramps and seasonal strength.","fit":"fits","evidence":["E13","E1","E27","E28","E29","E30","E33"],"verdict":"explanation fits the numbers"}}],"rulings":[{"attrs":{"caseId":"1045810_2016-01-31","revisionId":"a8ff0e701965","sampleIndex":0,"rulingIndex":0,"finding_index":0,"ruling":"unverified","reason":"The accelerating quarterly revenue growth (Q1 +4.4%, Q2 +4.5%, Q3 +6.5%, Q4 +12.0% YoY) is consistent with new product ramps, but the evidence pack contains no segment or product-level revenue data to show the named driver (new product releases) directly in the numbers. Management's MD&A (E33) lists the products but does not quantify their revenue contribution. The pattern could also reflect seasonal strength. Per the standard, a causal driver must be visible in the numbers (e.g., a mix shift in segment sales); it is not, so the explanation rests on management's word.","evidence":["E1","E13","E27","E28","E29","E30","E33"],"rebuttal":{"finding_index":0,"innocent_explanation":"The accelerating quarterly revenue growth (Q1 +4.4%, Q2 +4.5%, Q3 +6.5%, Q4 +12.0% YoY) aligns with the launch and ramp of new products (GeForce GTX TITAN X, GTX 980 Ti, GTX 950, VR products) cited by management, and the full-year revenue growth of 7.0% is consistent with this pattern.","evidence":["E27","E28","E29","E30","E33"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.82}}],"audit":[{"seq":1,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E1 (evidence)","kind":"upsertEntity"},{"seq":10,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E10 (evidence)","kind":"upsertEntity"},{"seq":11,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E11 (evidence)","kind":"upsertEntity"},{"seq":12,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E12 (evidence)","kind":"upsertEntity"},{"seq":13,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E13 (evidence)","kind":"upsertEntity"},{"seq":14,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E14 (evidence)","kind":"upsertEntity"},{"seq":