3000","accn":"0001564590-20-007744","filed":"2020-02-28"},{"cik":"1065837","company":"Skechers","fy_end":"2019-12-31","concept":"current_liabilities","tag":"LiabilitiesCurrent","value":"1238231000","accn":"0001564590-20-007744","filed":"2020-02-28"},{"cik":"1065837","company":"Skechers","fy_end":"2019-12-31","concept":"lt_debt","tag":"LongTermDebtNoncurrent","value":"49183000","accn":"0001564590-20-007744","filed":"2020-02-28"}]},"company":{"attrs":{"cik":1065837,"company":"Skechers","fy_end":"2019-12-31","activeRevision":"32281b279b46","liveRevision":""}},"filings":[{"attrs":{"accn":"0001564590-19-005775","filed":"2019-03-01","cik":1065837,"company":"Skechers","url":"https://www.sec.gov/Archives/edgar/data/1065837/000156459019005775/0001564590-19-005775-index.htm","form":"10-K"}},{"attrs":{"accn":"0001564590-20-007744","filed":"2020-02-28","cik":1065837,"company":"Skechers","url":"https://www.sec.gov/Archives/edgar/data/1065837/000156459020007744/skx-10k_20191231.htm","form":"10-K"}},{"attrs":{"accn":"0001564590-21-009442","filed":"2021-02-26","cik":1065837,"company":"Skechers","url":"https://www.sec.gov/Archives/edgar/data/1065837/000156459021009442/0001564590-21-009442-index.htm","form":"10-K"}},{"attrs":{"accn":"0001564590-22-007170","filed":"2022-02-25","cik":1065837,"company":"Skechers","url":"https://www.sec.gov/Archives/edgar/data/1065837/000156459022007170/0001564590-22-007170-index.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1065837_2019-12-31","revisionId":"32281b279b46","sampleIndex":2,"findingIndex":3,"management_says":"No explicit explanation for why receivables grew 28.6% vs 12.5% revenue growth (DSO 39→45 days) (E25).","numbers_show":"Quarterly signals show receivables outpacing revenue each quarter, especially Q3 (+31.4% receivables vs +15.1% revenue, DSO 39→45) (E29). This pattern is consistent with a mix shift to international wholesale (which carries receivables) but the Q3 spike suggests possible quarter-end shipment timing, extended terms, or channel loading that is not discussed. The Beneish DSRI=1.14 and AQI=5.16 flag asset quality deterioration (E31).","fit":"unverified","evidence":["E25","E27","E28","E29","E30","E31","E44"],"verdict":"explanation fits the numbers"}}],"rulings":[{"attrs":{"caseId":"1065837_2019-12-31","revisionId":"32281b279b46","sampleIndex":2,"rulingIndex":3,"finding_index":3,"ruling":"unverified","reason":"Management provides no explicit explanation for the 28.6% receivables growth vs 12.5% revenue growth (DSO 39→45 days). The defender attributes it to international wholesale mix shift, Mexico JV acquisition, and Q3 seasonal timing, but the evidence pack lacks segment-level receivables, payment terms, acquisition receivable amounts, or management commentary on Q3 timing. The Beneish AQI spike (5.16) is also unaddressed. The explanation rests on inference, not reported numbers.","evidence":["E25","E27","E28","E29","E30","E31","E44","E36"],"rebuttal":{"finding_index":3,"innocent_explanation":"The 28.6% receivables growth vs 12.5% revenue growth (DSO 39→45 days) is explained by the shift to international wholesale (which carries longer payment terms) growing 19.8% and the Mexico joint venture acquisition adding receivables; the Q3 spike reflects seasonal distributor shipment timing. The Beneish AQI rise reflects acquisition-related intangible asset growth.","evidence":["E25","E29","E44","E50","E36","E31","E10","E22","E8","E20","E9","E21"],"support":"numbers"},"final_verdict":"explanation fits the numbers","confidence":0.9}}],"audit":[{"seq":31,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E31 (evidence)","kind":"upsertEntity"},{"seq":145,"actor":"evidence-pack","summary":"evidence:1065837_2019-12-31:32281b279b46:E31 (evidence)","kind":"upsertEntity"},{"seq":146,"actor":"evidence-pack","summary":"filing:accn:0001564590-19-005775 -[supports]-> evidence:1065837_2019-12-31:32281b279b46:E31","kind":"relate"},{"seq":147,"actor":"evidence-pack","