"filed":"2013-03-21"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"revenue","tag":"SalesRevenueNet","value":"1591188000","accn":"0001397187-14-000021","filed":"2014-03-27"}]},"company":{"attrs":{"cik":1397187,"company":"Lululemon","fy_end":"2014-02-02","activeRevision":"64a4664c5f25","liveRevision":""}},"filings":[{"attrs":{"accn":"0001193125-12-262708","filed":"2012-06-07","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000119312512262708/0001193125-12-262708-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001193125-12-383973","filed":"2012-09-07","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000119312512383973/0001193125-12-383973-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001193125-12-492935","filed":"2012-12-06","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000119312512492935/0001193125-12-492935-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001193125-13-118393","filed":"2013-03-21","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000119312513118393/0001193125-13-118393-index.htm","form":"10-K"}},{"attrs":{"accn":"0001193125-13-253430","filed":"2013-06-10","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000119312513253430/0001193125-13-253430-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001397187-13-000022","filed":"2013-09-12","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000139718713000022/0001397187-13-000022-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001397187-13-000047","filed":"2013-12-12","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000139718713000047/0001397187-13-000047-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001397187-14-000021","filed":"2014-03-27","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000139718714000021/lulu-20140202x10k.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":0,"findingIndex":4,"management_says":"Quarterly data incomplete; cannot assess shipment timing or channel loading.","numbers_show":"No quarter-level revenue/receivables data available in the evidence pack to evaluate whether part of the growth came from timing or terms changes.","fit":"unverified","evidence":["E25"],"verdict":"explanation fits the numbers"}},{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":1,"findingIndex":2,"management_says":"Growth drivers are demand-based: brand strength, new products, higher transactions (E32).","numbers_show":"Beneish M-score flagged (DSRI=1.61) due to receivables growing faster than revenue, but absolute receivables are trivial ($11.9M vs $1.59B revenue). The DSRI signal reflects a tiny base effect, not channel stuffing. No quarter-level data to test shipment timing (E25).","fit":"fits","evidence":["E23","E25","E26","E32"],"verdict":"explanation fits the numbers"}}],"rulings":[{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":0,"rulingIndex":4,"finding_index":4,"ruling":"fits","reason":"The evidence pack explicitly states that quarterly revenue/receivables data is incomplete (E25), corroborating the claim that intra-year timing or channel loading cannot be assessed.","evidence":["E25"],"rebuttal":{"finding_index":4,"innocent_explanation":"The evidence pack contains no quarterly revenue or receivables data (E25), so intra-year timing or channel loading cannot be assessed; this is a data limitation, not a negative finding.","evidence":["E25"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.8}},{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":1,"rulingIndex":2,"finding_index":2,"ruling":"fits","reason":"The Beneish M-score flag (E26) is driven by DSRI=1.61, which reflects receivables growing 87% vs revenue 16% (E23). However, absolute receivables are trivial ($11.9M vs $1.59B revenue, E12, E18), so the DSRI signal is a base-effect artifact, not evidence of channel stuffing. Management's demand-driven growth narrative (E32) is supported by 7% comparable sales growth and 43 new store openings (E35). No quarterly data exists to test shipment timing (E25), but the available numbers do not contradict the demand-driven explanation.","evidence":["E23","E25","E26","E32"],"rebuttal":{"finding_index":2,"innocent_explanation":"The Beneish M-score flag is a false positive caused by the tiny receivables base ($6.4M to $11.9M) generating a large percentage change (DSRI=1.61) but trivial absolute impact. Management's demand-driven growth narrative is supported by 7% comparable sales growth and 43 new store openings. No quarter-level data exists to test for shipment timing effects.","evidence":["E23","E25","E26","E32"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.78}}],"audit":[{"seq":25,"actor":"evidence-pack","summary":"evidence:ingest:1397187_2014-02-02:64a4664c5f25:E25 (evidence)","kind":"upsertEntity"},{"seq":120,"actor":"evidence-pack","summary":"evidence:1397187_2014-02-02:64a4664c5f25:E25 (evidence)","kind":"upsertEntity"},{"seq":121,"actor":"evidence-pack","summary":"filing:accn:0001193125-13-253430 -[supports]-> evidence:1397187_2014-02-02:64a4664c5f25:E25","kind":"relate"},{"seq":122,"actor":"evidence-pack","summary":"filing:accn:0001397187-13-000022 -[supports]-> evidence:1397187_2014-02-02:64a4664c5f25:E25","kind":"relate"},{"seq":123,"actor":"evidence-pack","summary":"filing:accn:0001397187-13-000047 -[supports]-> evidence:1397187_2014-02-02:64a4664c5f25:E25","kind":"relate"},{"seq":124,"actor":"evidence-pack","summary":"filing:accn:0001397187-14-000021 -[supports]-> evidence:1397187_2014-02-02:64a4664c5f25:E25","kind":"relate"},{"seq":125,"actor":"evidence-p