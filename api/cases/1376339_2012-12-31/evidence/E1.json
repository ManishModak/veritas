{"evidence":{"id":"E1","kind":"fact","text":"revenue for fiscal year ending 2011-12-31 = $7.8M (XBRL tag SalesRevenueNet)","source":"10-K accession 0001140361-12-017997, filed 2012-03-29"},"origins":{"queries":[{"sql":"SELECT * FROM veritas_pg.facts WHERE cik = 1376339 ORDER BY fy_end, CASE concept WHEN 'revenue' THEN 0 WHEN 'cogs' THEN 1 WHEN 'sga' THEN 2 WHEN 'depreciation' THEN 3 WHEN 'net_income' THEN 4 WHEN 'cfo' THEN 5 WHEN 'receivables' THEN 6 WHEN 'current_assets' THEN 7 WHEN 'ppe' THEN 8 WHEN 'assets' THEN 9 WHEN 'current_liabilities' THEN 10 WHEN 'lt_debt' THEN 11 ELSE 99 END","rows":[{"cik":"1376339","company":"MiMedx Group","fy_end":"2011-12-31","concept":"revenue","tag":"SalesRevenueNet","value":"7760446","accn":"0001140361-12-017997","filed":"2012-03-29"}],"mode":"zetaris","label":"executed on Zetaris","table":"facts"}],"rows":[{"cik":"1376339","company":"MiMedx Group","fy_end":"2011-12-31","concept":"revenue","tag":"SalesRevenueNet","value":"7760446","accn":"0001140361-12-017997","filed":"2012-03-29"}]},"company":{"attrs":{"cik":1376339,"company":"MiMedx Group","fy_end":"2012-12-31","activeRevision":"994b80496852","liveRevision":""}},"filings":[{"attrs":{"accn":"0001140361-12-017997","filed":"2012-03-29","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036112017997/0001140361-12-017997-index.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":0,"findingIndex":0,"management_says":"No explanation in evidence pack for why revenue grew 248.6%","numbers_show":"Revenue grew from $7.8M to $27.1M (+248.6%) per E1, E13, E25","fit":"unverified","evidence":["E1","E13","E25"],"verdict":"explanation unverified"}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":1,"findingIndex":0,"management_says":"No explanation provided in evidence for 248.6% revenue growth ($7.8M to $27.1M).","numbers_show":"Revenue grew 248.6% while receivables grew 304.5% and DSO increased from 89 to 103 days (E25). No segment, product, pricing, or acquisition revenue breakdown is in the pack.","fit":"unverified","evidence":["E1","E13","E25","E27"],"verdict":"explanation unverified"}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":2,"findingIndex":0,"management_says":"No explanation provided in evidence pack for revenue growth of 248.6% ($7.8M to $27.1M).","numbers_show":"Revenue grew from $7.8M to $27.1M (E1, E13); receivables grew from $1.9M to $7.7M (E7, E19), a 304.5% increase vs 248.6% revenue growth; DSO increased from 89 to 103 days (E25). Beneish M-score flagged with SGI=3.4861 and DSRI=1.1604 (E28).","fit":"unverified","evidence":["E1","E7","E13","E19","E25","E28"],"verdict":"explanation unverified"}}],"rulings":[{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":0,"rulingIndex":0,"finding_index":0,"ruling":"unverified","reason":"The evidence pack contains no management causal explanation for the 248.6% revenue growth; the defender acknowledges any explanation (organic demand, acquisitions, etc.) is outside the pack. Without a named driver visible in the reported numbers (segment sales, acquired revenue, quarterly timing), the explanation cannot be corroborated.","evidence":["E1","E13","E25"],"rebuttal":{"finding_index":0,"innocent_explanation":"Revenue growth of 248.6% could reflect organic demand expansion for MiMedx's regenerative medicine products, but the evidence pack contains no segment breakdown, acquisition disclosure, or MD&A quantification of drivers.","evidence":["E1","E13","E25"],"support":"outside the pack"},"final_verdict":"explanation unverified","confidence":0.95}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":1,"rulingIndex":0,"finding_index":0,"ruling":"unverified","reason":"The evidence pack contains no management causal explanation for the 248.6% revenue growth. The MD&A excerpts provided (E29, E30) discuss depreciation allocation and financing cash flows, not revenue drivers. The defender's suggested explanations (organic growth, Surgical Biologics acquisition) are not supported by any segment, product, or acquired-revenue disclosure in the pack.","evidence":["E1","E13","E25","E27","E29","E30"],"rebuttal":{"finding_index":0,"innocent_explanation":"The 248.6% revenue increase may reflect organic growth from expanded product adoption and the Surgical Biologics acquisition referenced in financing cash flows (E30), but the pack lacks segment revenue or acquired revenue data to quantify these drivers.","evidence":["E1","E13","E25","E30"],"support":"outside the pack"},"final_verdict":"explanation unverified","confidence":0.95}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":2,"rulingIndex":0,"finding_index":0,"ruling":"unverified","reason":"Management provides no causal explanation for the 248.6% revenue growth in the evidence pack. The only MD&A excerpts (E29, E30) discuss depreciation allocation and financing cash flows, not revenue drivers. The defender's suggestion of a Surgical Biologics acquisition contribution (E30) is not quantified in the pack.","evidence":["E29","E30","E27"],"rebuttal":{"finding_index":0,"innocent_explanation":"The 248.6% revenue growth may reflect contributions from the Surgical Biologics acquisition referenced in financing activities (E30) combined with organic commercial expansion, but the evidence pack lacks segment or acquired revenue data to quantify the drivers.","evidence":["E13","E30"],"support":"outside the pack"},"final_verdict":"explanation unverified","confidence":0.95}}],"audit":[{"seq":1,"actor":"evidence-pack","summary":"evidence:ingest:1376339_2012-12-31:994b80496852:E1 (evidence)","kind":"upsertEntity"},{"seq":10,"actor":"evidence-pack","summary":"evidence:ingest:1376339_2012-12-31:994b80496852:E10 (evidence)","kind":"upsertEntity"},{"seq":11,"actor":"evidence-pack"