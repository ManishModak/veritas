0001140361-12-017997","filed":"2012-03-29"},{"cik":"1376339","company":"MiMedx Group","fy_end":"2012-12-31","concept":"revenue","tag":"SalesRevenueGoodsNet","value":"27053773","accn":"0001140361-13-012765","filed":"2013-03-15"}]},"company":{"attrs":{"cik":1376339,"company":"MiMedx Group","fy_end":"2012-12-31","activeRevision":"994b80496852","liveRevision":""}},"filings":[{"attrs":{"accn":"0001140361-11-039734","filed":"2011-08-04","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036111039734/0001140361-11-039734-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001140361-11-053502","filed":"2011-11-14","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036111053502/0001140361-11-053502-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001140361-12-017997","filed":"2012-03-29","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036112017997/0001140361-12-017997-index.htm","form":"10-K"}},{"attrs":{"accn":"0001140361-12-024988","filed":"2012-05-14","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036112024988/0001140361-12-024988-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001140361-12-036885","filed":"2012-08-14","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036112036885/0001140361-12-036885-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001140361-12-046891","filed":"2012-11-13","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036112046891/0001140361-12-046891-index.htm","form":"10-Q"}},{"attrs":{"accn":"0001140361-13-012765","filed":"2013-03-15","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000114036113012765/form10k.htm","form":"10-K"}},{"attrs":{"accn":"0001376339-14-000005","filed":"2014-03-04","cik":1376339,"company":"MiMedx Group","url":"https://www.sec.gov/Archives/edgar/data/1376339/000137633914000005/0001376339-14-000005-index.htm","form":"10-Q"}}],"findings":[{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":1,"findingIndex":0,"management_says":"No explanation provided in evidence for 248.6% revenue growth ($7.8M to $27.1M).","numbers_show":"Revenue grew 248.6% while receivables grew 304.5% and DSO increased from 89 to 103 days (E25). No segment, product, pricing, or acquisition revenue breakdown is in the pack.","fit":"unverified","evidence":["E1","E13","E25","E27"],"verdict":"explanation unverified"}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":2,"findingIndex":1,"management_says":"No explanation provided in evidence pack for receivables growing faster than revenue (DSO increase).","numbers_show":"Receivables growth (304.5%) exceeded revenue growth (248.6%); DSO rose 14 days (E25). No quarterly data to assess shipment timing or channel loading (E27).","fit":"unverified","evidence":["E7","E13","E19","E25","E27"],"verdict":"explanation unverified"}}],"rulings":[{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":1,"rulingIndex":0,"finding_index":0,"ruling":"unverified","reason":"The evidence pack contains no management causal explanation for the 248.6% revenue growth. The MD&A excerpts provided (E29, E30) discuss depreciation allocation and financing cash flows, not revenue drivers. The defender's suggested explanations (organic growth, Surgical Biologics acquisition) are not supported by any segment, product, or acquired-revenue disclosure in the pack.","evidence":["E1","E13","E25","E27","E29","E30"],"rebuttal":{"finding_index":0,"innocent_explanation":"The 248.6% revenue increase may reflect organic growth from expanded product adoption and the Surgical Biologics acquisition referenced in financing cash flows (E30), but the pack lacks segment revenue or acquired revenue data to quantify these drivers.","evidence":["E1","E13","E25","E30"],"support":"outside the pack"},"final_verdict":"explanation unverified","confidence":0.95}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":1,"rulingIndex":1,"finding_index":1,"ruling":"unverified","reason":"The evidence pack contains no management causal explanation for receivables growing 304.5% versus 248.6% revenue growth and DSO rising from 89 to 103 days. The MD&A excerpts do not address receivables, payment terms, shipment timing, or acquisition-related receivables. The defender's hypotheses (year-end shipment timing, extended terms, acquired receivables) rely on facts outside the pack, and quarterly data is incomplete (E27).","evidence":["E7","E19","E25","E27","E29","E30"],"rebuttal":{"finding_index":1,"innocent_explanation":"Receivables growing faster than revenue and DSO rising could stem from year-end shipment timing, extended payment terms for new customers, or receivables acquired with Surgical Biologics (E30), but the pack has no quarterly data (E27) or term disclosures to confirm.","evidence":["E7","E19","E25","E27","E30"],"support":"outside the pack"},"final_verdict":"explanation unverified","confidence":0.95}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":2,"rulingIndex":0,"finding_index":0,"ruling":"unverified","reason":"Management provides no causal explanation for the 248.6% revenue growth in the evidence pack. The only MD&A excerpts (E29, E30) discuss depreciation allocation and financing cash flows, not revenue drivers. The defender's suggestion of a Surgical Biologics acquisition contribution (E30) is not quantified in the pack.","evidence":["E29","E30","E27"],"rebuttal":{"finding_index":0,"innocent_explanation":"The 248.6% revenue growth may reflect contributions from the Surgical Biologics acquisition referenced in financing activities (E30) combined with organic commercial expansion, but the evidence pack lacks segment or acquired revenue data to quantify the drivers.","evidence":["E13","E30"],"support":"outside the pack"},"final_verdict":"explanation unverified","confidence":0.95}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":2,"rulingIndex":1,"finding_index":1,"ruling":"unverified","reason":"Management provides no explanation for receivables growing 304.5% vs. 248.6% revenue growth (DSI increase from 89 to 103 days). The pack lacks aging schedules or quarterly data (E27) to assess timing or channel loading. The defender's hypothesis of acquired receivables or extended terms rests on facts outside the pack.","evidence":["E29","E30","E27"],"rebuttal":{"finding_index":1,"innocent_explanation":"The receivables growth outpacing revenue and DSO increase could stem from acquired receivables from the Surgical Biologics acquisition (E30) or extended payment terms to support rapid sales growth, but the pack contains no aging schedules or quarterly data to confirm.","evidence":["E19","E30","E27"],"support":"outside the pack"},"final_verdict":"explanation unverified","confidence":0.95}},{"attrs":{"caseId":"1376339_2012-12-31","revisionId":"994b80496852","sampleIndex":2,"rulingIndex":2,"finding_index":2,"ruling":"unverified","reason":"Management provides no explanation for operating cash flow remaining negative (-$3.4M) despite revenue tripling. The MD&A excerpt (E30) only covers financing cash flows. The defender's working capital explanation (rise in current assets, fall in current liabilities) uses numbers from the pack (E8, E11, E20, E23) but is not a management explanation; the claim under test is management's causal statement, which is absent.","evidence":["E29","E30","E27"],"rebuttal":{"finding_index":2,"innocent_explanation":"Operating cash flow remained negative because the $19.3M revenue increase was largely absorbed by a $11.2M rise in current assets (E8, E20) and a $2.8M decline in current liabilities (E11, E23), indicating heavy working capital investment to fund growth.","evidence":["E8","E11","E20","E23","E18"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.95}}],"audit":[{"seq":27,"actor":"evidence-pack","summary":"evidence:ingest:1376339_2012-12-31:994b80496852:E27 (evidence)","kind":"upsertEntity"},{"seq":103,"actor":"evidence-pack","summary":"evidence:1376339_2012-12-31:994b80496852:E27 (evidence)","kind":"upsertEntity"},{"seq":104,"actor":"evidence-pack","summary":"filing:accn:0001140361-12-024988 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":105,"actor":"evidence-pack","summary":"filing:accn:0001140361-12-036885 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":106,"actor":"evidence-pack","summary":"filing:accn:0001140361-12-046891 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":107,"actor":"evidence-pack","summary":"filing:accn:0001376339-14-000005 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":108,"actor":"evidence-pack","summary":"filing:accn:0001140361-13-012765 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":109,"actor":"evidence-pack","summary":"filing:accn:0001140361-11-039734 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":110,"actor":"evidence-pack","summary":"filing:accn:0001140361-11-053502 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":111,"actor":"evidence-pack","summary":"filing:accn:0001140361-12-017997 -[supports]-> evidence:1376339_2012-12-31:994b80496852:E27","kind":"relate"},{"seq":170,"actor":"nvidia/nemotron-3-ultra-550b-a55b","summary":"evidence:1376339_2012-12-31:994b80496852:E27 -[supports]-> finding:1376339_2012-12-31:994b80496852:s1:f0","kind":"relate"},{"seq":186,"actor":"nvidia/nemotron-3-ultra-550b-a55b","summary":"evidence:1376339_2012-12-31:994b80496852:E27 -[cites]-> ruling:13763