{"evidence":{"id":"E1","kind":"fact","text":"revenue for fiscal year ending 2014-12-31 = $2,100.6M (XBRL tag SalesRevenueGoodsNet)","source":"10-K accession 0001050797-15-000002, filed 2015-02-26"},"origins":{"queries":[{"sql":"SELECT * FROM veritas_pg.facts WHERE cik = 1050797 ORDER BY fy_end, CASE concept WHEN 'revenue' THEN 0 WHEN 'cogs' THEN 1 WHEN 'sga' THEN 2 WHEN 'depreciation' THEN 3 WHEN 'net_income' THEN 4 WHEN 'cfo' THEN 5 WHEN 'receivables' THEN 6 WHEN 'current_assets' THEN 7 WHEN 'ppe' THEN 8 WHEN 'assets' THEN 9 WHEN 'current_liabilities' THEN 10 WHEN 'lt_debt' THEN 11 ELSE 99 END","rows":[{"cik":"1050797","company":"Columbia Sportswear","fy_end":"2014-12-31","concept":"revenue","tag":"SalesRevenueGoodsNet","value":"2100590000","accn":"0001050797-15-000002","filed":"2015-02-26"}],"mode":"zetaris","label":"executed on Zetaris","table":"facts"}],"rows":[{"cik":"1050797","company":"Columbia Sportswear","fy_end":"2014-12-31","concept":"revenue","tag":"SalesRevenueGoodsNet","value":"2100590000","accn":"0001050797-15-000002","filed":"2015-02-26"}]},"company":{"attrs":{"cik":1050797,"company":"Columbia Sportswear","fy_end":"2015-12-31","activeRevision":"084cb7cda56c","liveRevision":""}},"filings":[{"attrs":{"accn":"0001050797-15-000002","filed":"2015-02-26","cik":1050797,"company":"Columbia Sportswear","url":"https://www.sec.gov/Archives/edgar/data/1050797/000105079715000002/0001050797-15-000002-index.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1050797_2015-12-31","revisionId":"084cb7cda56c","sampleIndex":2,"findingIndex":0,"management_says":"Revenue grew 11% (15% constant-currency) led by Columbia brand, prAna brand ($56M incremental for first five months of 2015), and Sorel brand, partially offset by Mountain Hardwear decline (E33, E36).","numbers_show":"Revenue rose $225.6M (10.7%) to $2,326.2M (E1, E12, E23). prAna acquired May 30, 2014; the cited $56M for Jan–May 2015 represents ~25% of total growth, a timing/acquisition effect visible in the year-over-year comparison (E36).","fit":"fits","evidence":["E1","E12","E23","E33","E36"],"verdict":"explanation unverified"}}],"rulings":[{"attrs":{"caseId":"1050797_2015-12-31","revisionId":"084cb7cda56c","sampleIndex":2,"rulingIndex":0,"finding_index":0,"ruling":"unverified","reason":"Management attributes 10.7% revenue growth to Columbia, prAna ($56M incremental for Jan–May 2015), and Sorel brands. The $56M prAna increment is reported in MD&A (E36), but the contributions of Columbia and Sorel are not quantified in any reported numbers (XBRL facts or MD&A segment tables) within the evidence pack. The explanation for the majority of growth (~75%) rests on management's word without visible driver sizes in the numbers.","evidence":["E1","E12","E23","E33","E36"],"rebuttal":{"finding_index":0,"innocent_explanation":"The 10.7% revenue growth ($225.6M) is fully accounted for by organic brand strength (Columbia, Sorel) and the prAna acquisition timing effect, with MD&A reporting $56M of incremental prAna sales for Jan–May 2015 (≈25% of growth).","evidence":["E1","E12","E23","E33","E36"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.85}}],"audit":[{"seq":1,"actor":"evidence-pack","summary":"evidence:ingest:1050797_2015-12-31:084cb7cda56c:E1 (evidence)","kind":"upsertEntity"},{"seq":10,"actor":"evidence-pack","summary":"evidence:ingest:1050797_2015-12-31:084cb7cda56c:E10 (evidence)","kind":"upsertEntity"},{"seq":11,"actor":"evidence-pack","summary":"evidence:ingest:1050797_2015-12-31:084cb7cda56c:E11 (evidence)","kind":"upsertEntity"},{"seq":12,"actor":"evidence-pack","summary":"evidence:ingest:1050797_2015-12-31:084cb7cda56c:E12 (evidence)","kind":"upsertEntity"},{"seq":13,"actor":"evidence-pack","summary":"evidence:ingest:1050797_2015-12-31:084cb7cda56c:E13 (evidence)","kind":"upsertEntity"},{"seq":14,"actor":"evidence-pack","summary":"evidence:ingest:1050797_2015-12-31:084cb7cda56c:E14 (evidence)","kind":"upsertEntity"},{"seq":15,"actor":"ev