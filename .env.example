# Veritas settings, all optional. The recorded demo (npm start) needs none of them.
# The app reads environment variables; export these in your shell. Never commit a real .env.

# Recorded runs only (default). Set to false for live runs.
SAMPLE_MODE=true

# Live runs go through Meterless Nightshift (the primary AI provider). Copy both from Nightshift's Console.
# Your NVIDIA API key goes in Nightshift's Providers tab, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Fallback only, used when METERLESS_BASE_URL is empty: call NVIDIA NIM directly. Placeholder only.
NVIDIA_API_KEY=

# Zetaris: URL of the SQL bridge (bridge/zetaris_bridge.py), e.g. through ssh -L 8787:localhost:8787 <zetaris-host>.
# Leave empty to use the bundled CSVs.
ZETARIS_BRIDGE_URL=
ZETARIS_SCHEMA=veritas_pg

# Server port and where live results and memory are saved.
PORT=8788
VERITAS_STATE_DIR=
