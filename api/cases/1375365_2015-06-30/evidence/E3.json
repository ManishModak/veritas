{"evidence":{"id":"E3","kind":"fact","text":"sga for fiscal year ending 2014-06-30 = $23.0M (XBRL tag GeneralAndAdministrativeExpense)","source":"10-K accession 0001445305-14-003958, filed 2014-09-15"},"origins":{"queries":[{"sql":"SELECT * FROM veritas_pg.facts WHERE cik = 1375365 ORDER BY fy_end, CASE concept WHEN 'revenue' THEN 0 WHEN 'cogs' THEN 1 WHEN 'sga' THEN 2 WHEN 'depreciation' THEN 3 WHEN 'net_income' THEN 4 WHEN 'cfo' THEN 5 WHEN 'receivables' THEN 6 WHEN 'current_assets' THEN 7 WHEN 'ppe' THEN 8 WHEN 'assets' THEN 9 WHEN 'current_liabilities' THEN 10 WHEN 'lt_debt' THEN 11 ELSE 99 END","rows":[{"cik":"1375365","company":"Super Micro Computer","fy_end":"2014-06-30","concept":"sga","tag":"GeneralAndAdministrativeExpense","value":"23017000","accn":"0001445305-14-003958","filed":"2014-09-15"}],"mode":"zetaris","label":"executed on Zetaris","table":"facts"}],"rows":[{"cik":"1375365","company":"Super Micro Computer","fy_end":"2014-06-30","concept":"sga","tag":"GeneralAndAdministrativeExpense","value":"23017000","accn":"0001445305-14-003958","filed":"2014-09-15"}]},"company":{"attrs":{"cik":1375365,"company":"Super Micro Computer","fy_end":"2015-06-30","activeRevision":"d0671290cb58","liveRevision":""}},"filings":[{"attrs":{"accn":"0001445305-14-003958","filed":"2014-09-15","cik":1375365,"company":"Super Micro Computer","url":"https://www.sec.gov/Archives/edgar/data/1375365/000144530514003958/0001445305-14-003958-index.htm","form":"10-K"}}],"findings":[],"rulings":[{"attrs":{"caseId":"1375365_2015-06-30","revisionId":"d0671290cb58","sampleIndex":0,"rulingIndex":3,"finding_index":3,"ruling":"fits","reason":"Management attributes net income increase to higher gross profit from higher sales and improved margins. Reported numbers confirm: revenue grew 35.7%, gross profit rose from $225.5M to $320.3M (margin 15.4%→16.1%), and operating profit increased (SG&A and depreciation grew slower). The divergence in operating cash flow is mechanically explained by working capital changes visible in the facts (receivables +$110M, inventory +$148M, current liabilities +$143M), but that does not contradict the net income explanation.","evidence":["E13","E1","E14","E2","E15","E3","E16","E4","E5","E17","E6","E18","E7","E19","E20","E11","E23"],"rebuttal":{"finding_index":3,"innocent_explanation":"The divergence between net income (+88%) and operating cash flow (negative $44.6M) is mechanically explained by a $114M net working capital investment (receivables +$110M, inventory +$148M, partially offset by current liabilities +$143M) required to fund 35.7% revenue growth and prepare for FY2016, a normal cash flow pattern for high-growth companies where the build is collectible and salable per stated policies.","evidence":["E5","E17","E6","E18","E7","E19","E20","E11","E23","E39"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.8}}],"audit":[{"seq":3,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E3 (evidence)","kind":"upsertEntity"},{"seq":30,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E30 (evidence)","kind":"upsertEntity"},{"seq":31,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E31 (evidence)","kind":"upsertEntity"},{"seq":32,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E32 (evidence)","kind":"upsertEntity"},{"seq":33,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E33 (evidence)","kind":"upsertEntity"},{"seq":34,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E34 (evidence)","kind":"upsertEntity"},{"seq":35,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E35 (evidence)","kind":"upsertEntity"},{"seq":36,"actor":"evidence-pack","summary":"evidence:ingest:1375365_2015-06-30:d0671290cb58:E36 (evidence)","kind":"upsertEntity"},{"seq":37,"actor":"evidence-pack","summary"