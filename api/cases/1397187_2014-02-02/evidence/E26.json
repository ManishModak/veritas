-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"depreciation","tag":"Depreciation","value":"48177000","accn":"0001397187-14-000021","filed":"2014-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"net_income","tag":"NetIncomeLoss","value":"279547000","accn":"0001397187-14-000021","filed":"2014-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"cfo","tag":"NetCashProvidedByUsedInOperatingActivities","value":"278339000","accn":"0001397187-14-000021","filed":"2014-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"receivables","tag":"ReceivablesNetCurrent","value":"11903000","accn":"0001397187-14-000021","filed":"2014-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"current_assets","tag":"AssetsCurrent","value":"942839000","accn":"0001397187-14-000021","filed":"2014-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"ppe","tag":"PropertyPlantAndEquipmentNet","value":"255603000","accn":"0001397187-14-000021","filed":"2014-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"assets","tag":"Assets","value":"1249688000","accn":"0001397187-14-000021","filed":"2014-03-27"},{"cik":"1397187","company":"Lululemon","fy_end":"2014-02-02","concept":"current_liabilities","tag":"LiabilitiesCurrent","value":"113514000","accn":"0001397187-14-000021","filed":"2014-03-27"}]},"company":{"attrs":{"cik":1397187,"company":"Lululemon","fy_end":"2014-02-02","activeRevision":"64a4664c5f25","liveRevision":""}},"filings":[{"attrs":{"accn":"0001193125-13-118393","filed":"2013-03-21","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000119312513118393/0001193125-13-118393-index.htm","form":"10-K"}},{"attrs":{"accn":"0001397187-14-000021","filed":"2014-03-27","cik":1397187,"company":"Lululemon","url":"https://www.sec.gov/Archives/edgar/data/1397187/000139718714000021/lulu-20140202x10k.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":0,"findingIndex":3,"management_says":"Beneish M-score flagged (DSRI=1.61) due to receivables growth.","numbers_show":"The DSRI signal reflects the large percentage increase in receivables, but the absolute amount ($5.5M increase) is immaterial. The flag does not indicate material earnings manipulation given the retail business model.","fit":"fits","evidence":["E26"],"verdict":"explanation fits the numbers"}},{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":1,"findingIndex":2,"management_says":"Growth drivers are demand-based: brand strength, new products, higher transactions (E32).","numbers_show":"Beneish M-score flagged (DSRI=1.61) due to receivables growing faster than revenue, but absolute receivables are trivial ($11.9M vs $1.59B revenue). The DSRI signal reflects a tiny base effect, not channel stuffing. No quarter-level data to test shipment timing (E25).","fit":"fits","evidence":["E23","E25","E26","E32"],"verdict":"explanation fits the numbers"}},{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":2,"findingIndex":1,"management_says":"No explicit explanation provided in the evidence pack for the receivables increase or flat operating cash flow.","numbers_show":"Receivables grew 87% in percentage terms but only $5.5M in absolute terms (2→3 days DSO). Operating cash flow was essentially unchanged despite higher net income, indicating strong cash conversion (CFO/net income ~100%). The Beneish M-score flags DSRI=1.61 due to the receivables percentage jump, but the absolute level remains trivial for a $1.6B retailer.","fit":"unverified","evidence":["E7","E18","E23","E6","E17","E5","E16","E26"],"verdict":"explanation fits the numbers"}}],"rulings":[{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":0,"rulingIndex":3,"finding_index":3,"ruling":"fits","reason":"The Beneish M-score flag is driven by DSRI, which reflects the large percentage increase in receivables; however, the absolute receivables balance remains negligible ($11.9M vs $1.6B revenue), so the flag does not indicate material manipulation.","evidence":["E26","E7","E18"],"rebuttal":{"finding_index":3,"innocent_explanation":"The Beneish M-score flag stems solely from the DSRI component reflecting a large percentage receivables increase on an immaterial $5.5M base, which does not indicate earnings manipulation in a business with negligible receivables.","evidence":["E26","E7","E18"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.8}},{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":1,"rulingIndex":2,"finding_index":2,"ruling":"fits","reason":"The Beneish M-score flag (E26) is driven by DSRI=1.61, which reflects receivables growing 87% vs revenue 16% (E23). However, absolute receivables are trivial ($11.9M vs $1.59B revenue, E12, E18), so the DSRI signal is a base-effect artifact, not evidence of channel stuffing. Management's demand-driven growth narrative (E32) is supported by 7% comparable sales growth and 43 new store openings (E35). No quarterly data exists to test shipment timing (E25), but the available numbers do not contradict the demand-driven explanation.","evidence":["E23","E25","E26","E32"],"rebuttal":{"finding_index":2,"innocent_explanation":"The Beneish M-score flag is a false positive caused by the tiny receivables base ($6.4M to $11.9M) generating a large percentage change (DSRI=1.61) but trivial absolute impact. Management's demand-driven growth narrative is supported by 7% comparable sales growth and 43 new store openings. No quarter-level data exists to test for shipment timing effects.","evidence":["E23","E25","E26","E32"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.78}},{"attrs":{"caseId":"1397187_2014-02-02","revisionId":"64a4664c5f25","sampleIndex":2,"rulingIndex":1,"finding_index":1,"ruling":"unverified","reason":"Management provides no causal explanation for the receivables increase or flat operating cash flow in the evidence pack. While the numbers show receivables grew only $5.5M (87% on a tiny base) leaving DSO at 3 days (E7, E18, E23), and CFO was essentially unchanged at ~$278M despite a $9M net income rise (E5, E6, E16, E17), the absence of a management-provided driver means the explanation cannot be corroborated or contradicted by the numbers alone.","evidence":["E7","E18","E23","E5","E6","E16","E17","E26"],"rebuttal":{"finding_index":1,"innocent_explanation":"The 87% receivables increase represents only $5.5M absolute growth (from $6.4M to $11.9M), leaving days sales outstanding at a trivial 3 days, consistent with a predominantly cash-based retail model. Operating cash flow remained flat near $278M despite a $9M net income increase, indicating ~100% cash conversion; the Beneish M-score flag stems solely from the percentage jump off a tiny base, not from any deterioration in credit quality or channel stuffing.","evidence":["E7","E18","E23","E6","E17","E5","E16","E26"],"support":"numbers"},"final_verdict":"explanation fits the numbers","confidence":0.92}}],"audit":[{"seq":26,"actor":"evidence-pack","summary":"evidence:ingest:1397187_2014-02-02:64a4664c5f25:E26 (evidence)","kind":"upsertEntity"},{"seq":129,"actor":"evidence-pack","summary":"evidence:1397187_2014-02-02:64a4664c5f25:E26 (evidence)","kind":"upsertEntity"},{"seq":130,"actor":"evidence-pack","summary":"filing:accn:0001193125-13-118393 -[supports]-> evidence:1397187_2014-02-02:64a4664c5f25:E26","kind":"relate"},{"seq":131,"actor":"evidence-pack","summary":"filing:accn:0001397187-14-000021 -[supports]-> evidence:1397187_2014-02-02:64a4664c5f25:E26","kind":"relate"},{"seq":200,"actor":"nvidia/nemotron-3-ultra-550b-a55b","summary":"evidence:1397187_2014-02-02:64a4664c5f25:E26 -[supports]-> finding:1397187_2014-