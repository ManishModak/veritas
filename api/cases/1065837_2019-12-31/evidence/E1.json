{"evidence":{"id":"E1","kind":"fact","text":"revenue for fiscal year ending 2018-12-31 = $4,642.1M (XBRL tag RevenueFromContractWithCustomerExcludingAssessedTax)","source":"10-K accession 0001564590-19-005775, filed 2019-03-01"},"origins":{"queries":[{"sql":"SELECT * FROM veritas_pg.facts WHERE cik = 1065837 ORDER BY fy_end, CASE concept WHEN 'revenue' THEN 0 WHEN 'cogs' THEN 1 WHEN 'sga' THEN 2 WHEN 'depreciation' THEN 3 WHEN 'net_income' THEN 4 WHEN 'cfo' THEN 5 WHEN 'receivables' THEN 6 WHEN 'current_assets' THEN 7 WHEN 'ppe' THEN 8 WHEN 'assets' THEN 9 WHEN 'current_liabilities' THEN 10 WHEN 'lt_debt' THEN 11 ELSE 99 END","rows":[{"cik":"1065837","company":"Skechers","fy_end":"2018-12-31","concept":"revenue","tag":"RevenueFromContractWithCustomerExcludingAssessedTax","value":"4642068000","accn":"0001564590-19-005775","filed":"2019-03-01"}],"mode":"zetaris","label":"executed on Zetaris","table":"facts"}],"rows":[{"cik":"1065837","company":"Skechers","fy_end":"2018-12-31","concept":"revenue","tag":"RevenueFromContractWithCustomerExcludingAssessedTax","value":"4642068000","accn":"0001564590-19-005775","filed":"2019-03-01"}]},"company":{"attrs":{"cik":1065837,"company":"Skechers","fy_end":"2019-12-31","activeRevision":"32281b279b46","liveRevision":""}},"filings":[{"attrs":{"accn":"0001564590-19-005775","filed":"2019-03-01","cik":1065837,"company":"Skechers","url":"https://www.sec.gov/Archives/edgar/data/1065837/000156459019005775/0001564590-19-005775-index.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1065837_2019-12-31","revisionId":"32281b279b46","sampleIndex":0,"findingIndex":0,"management_says":"Revenue growth of 12.5% primarily came from international wholesale and retail businesses (international wholesale +19.8%, direct-to-consumer +15.6%), while domestic wholesale declined 1.0%.","numbers_show":"Segment data confirms: international wholesale sales rose $407.8M (19.8%) to $2,462.6M; direct-to-consumer gross profit rose $121.1M (15.6%); domestic wholesale fell $12.0M (1.0%). International wholesale and retail represented 57.9% of 2019 sales.","fit":"fits","evidence":["E13","E1","E25","E42","E43","E44","E47","E34"],"verdict":"explanation unverified"}},{"attrs":{"caseId":"1065837_2019-12-31","revisionId":"32281b279b46","sampleIndex":2,"findingIndex":0,"management_says":"Revenue growth of 12.5% primarily came from international wholesale and retail businesses (E34, E42).","numbers_show":"International wholesale sales rose 19.8% ($407.8M) driven by subsidiary sales (+18.9%) and distributor sales (+24.6%) (E44). Direct-to-consumer gross profit rose 15.6% (E47). Domestic wholesale fell 1.0% (E43). The segment mix shift toward international wholesale (57.9% of sales) supports the revenue growth explanation.","fit":"fits","evidence":["E13","E1","E25","E43","E44","E47","E34"],"verdict":"explanation fits the numbers"}}],"rulings":[{"attrs":{"caseId":"1065837_2019-12-31","revisionId":"32281b279b46","sampleIndex":0,"rulingIndex":0,"finding_index":0,"ruling":"fits","reason":"Segment revenue data in MD&A (international wholesale +19.8%, direct-to-consumer +15.6%, domestic wholesale -1.0%) matches the consolidated revenue growth of 12.5% and the computed signal.","evidence":["E1","E13","E25","E42","E43","E44","E47"],"rebuttal":{"finding_index":0,"innocent_explanation":"The segment revenue data reported in MD&A confirms that the 12.5% consolidated revenue growth was driven by a 19.8% increase in international wholesale sales ($407.8M) and a 15.6% increase in direct-to-consumer gross profit ($121.1M), while domestic wholesale declined 1.0% ($12.0M). International wholesale and retail represented 57.9% of 2019 sales. This matches the computed revenue growth signal and the consolidated revenue facts.","evidence":["E1","E13","E25","E34","E42","E43","E44","E47"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.8}},{"attrs":{"caseId":"1065837_2019-12-31","revisionId":"32281b279b46","sampleIndex":2,"rulingIndex":0,"finding_index":0,"ruling":"fits","reason":"Segment data shows international wholesale sales grew 19.8% ($407.8M) and direct-to-consumer gross profit grew 15.6%, while domestic wholesale fell 1.0%. The $407.8M increase in international wholesale accounts for 70% of the total $578M revenue growth, corroborating management's claim that growth came primarily from international wholesale and retail.","evidence":["E13","E1","E43","E44","E47","E34"],"rebuttal":{"finding_index":0,"innocent_explanation":"The 12.5% revenue growth is fully accounted for by the 19.8% increase in international wholesale sales ($407.8M) and 15.6% growth in direct-to-consumer gross profit, while domestic wholesale declined slightly. The segment sales data confirm the mix shift toward international channels (57.9% of sales).","evidence":["E13","E1","E43","E44","E47","E34"],"support":"numbers"},"final_verdict":"explanation fits the numbers","confidence":0.9}}],"audit":[{"seq":1,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E1 (evidence)","kind":"upsertEntity"},{"seq":10,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E10 (evidence)","kind":"upsertEntity"},{"seq":11,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E11 (evidence)","kind":"upsertEntity"},{"seq":12,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E12 (evidence)","kind":"upsertEntity"},{"seq":13,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E13 (evidence)","kind":"upsertEntity"},{"seq":14,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E14 (evidence)","kind":"upsertEntity"},{"seq":15,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E15 (evidence)","kind":"upsertEntity"},{"seq":16,"actor":"evidence-pack","summary":"evidence:ingest:1065837_2019-12-31:32281b279b46:E16 (evidence)","kind":"ups