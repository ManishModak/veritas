{"evidence":{"id":"E1","kind":"fact","text":"revenue for fiscal year ending 2014-05-31 = $27,799.0M (XBRL tag SalesRevenueNet)","source":"10-K accession 0000320187-14-000097, filed 2014-07-25"},"origins":{"queries":[{"sql":"SELECT * FROM veritas_pg.facts WHERE cik = 320187 ORDER BY fy_end, CASE concept WHEN 'revenue' THEN 0 WHEN 'cogs' THEN 1 WHEN 'sga' THEN 2 WHEN 'depreciation' THEN 3 WHEN 'net_income' THEN 4 WHEN 'cfo' THEN 5 WHEN 'receivables' THEN 6 WHEN 'current_assets' THEN 7 WHEN 'ppe' THEN 8 WHEN 'assets' THEN 9 WHEN 'current_liabilities' THEN 10 WHEN 'lt_debt' THEN 11 ELSE 99 END","rows":[{"cik":"320187","company":"Nike","fy_end":"2014-05-31","concept":"revenue","tag":"SalesRevenueNet","value":"27799000000","accn":"0000320187-14-000097","filed":"2014-07-25"}],"mode":"zetaris","label":"executed on Zetaris","table":"facts"}],"rows":[{"cik":"320187","company":"Nike","fy_end":"2014-05-31","concept":"revenue","tag":"SalesRevenueNet","value":"27799000000","accn":"0000320187-14-000097","filed":"2014-07-25"}]},"company":{"attrs":{"cik":320187,"company":"Nike","fy_end":"2015-05-31","activeRevision":"2f331a24d239","liveRevision":""}},"filings":[{"attrs":{"accn":"0000320187-14-000097","filed":"2014-07-25","cik":320187,"company":"Nike","url":"https://www.sec.gov/Archives/edgar/data/320187/000032018714000097/0000320187-14-000097-index.htm","form":"10-K"}}],"findings":[],"rulings":[{"attrs":{"caseId":"320187_2015-05-31","revisionId":"2f331a24d239","sampleIndex":0,"rulingIndex":2,"finding_index":2,"ruling":"fits","reason":"Reported futures orders growth (13% currency-neutral, E36) and actual revenue growth (10.1%, E13 vs E1) are directionally consistent, and quarterly revenue shows steady growth with no receivables spikes (E27-E30), corroborating management's caution that futures orders are not precise predictors due to timing, mix, and cancellations (E37).","evidence":["E1","E13","E27","E28","E29","E30","E36","E37"],"rebuttal":{"finding_index":2,"innocent_explanation":"