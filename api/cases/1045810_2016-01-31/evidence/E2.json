{"evidence":{"id":"E2","kind":"fact","text":"cogs for fiscal year ending 2015-01-25 = $2,082.0M (XBRL tag CostOfRevenue)","source":"10-K accession 0001045810-15-000036, filed 2015-03-12"},"origins":{"queries":[{"sql":"SELECT * FROM veritas_pg.facts WHERE cik = 1045810 ORDER BY fy_end, CASE concept WHEN 'revenue' THEN 0 WHEN 'cogs' THEN 1 WHEN 'sga' THEN 2 WHEN 'depreciation' THEN 3 WHEN 'net_income' THEN 4 WHEN 'cfo' THEN 5 WHEN 'receivables' THEN 6 WHEN 'current_assets' THEN 7 WHEN 'ppe' THEN 8 WHEN 'assets' THEN 9 WHEN 'current_liabilities' THEN 10 WHEN 'lt_debt' THEN 11 ELSE 99 END","rows":[{"cik":"1045810","company":"Nvidia","fy_end":"2015-01-25","concept":"cogs","tag":"CostOfRevenue","value":"2082030000","accn":"0001045810-15-000036","filed":"2015-03-12"}],"mode":"zetaris","label":"executed on Zetaris","table":"facts"}],"rows":[{"cik":"1045810","company":"Nvidia","fy_end":"2015-01-25","concept":"cogs","tag":"CostOfRevenue","value":"2082030000","accn":"0001045810-15-000036","filed":"2015-03-12"}]},"company":{"attrs":{"cik":1045810,"company":"Nvidia","fy_end":"2016-01-31","activeRevision":"a8ff0e701965","liveRevision":""}},"filings":[{"attrs":{"accn":"0001045810-15-000036","filed":"2015-03-12","cik":1045810,"company":"Nvidia","url":"https://www.sec.gov/Archives/edgar/data/1045810/000104581015000036/0001045810-15-000036-index.htm","form":"10-K"}}],"findings":[{"attrs":{"caseId":"1045810_2016-01-31","revisionId":"a8ff0e701965","sampleIndex":2,"findingIndex":3,"management_says":"Inventory provisions increased to $112M in FY2016 from $59M in FY2015, hurting gross margin (E43, E44).","numbers_show":"COGS rose from $2,082M to $2,199M (E2, E14); gross margin pressure consistent with higher provisions. Tegra margin decline attributed to provisions, warranty charge, and mix shift (E44).","fit":"fits","evidence":["E2","E14","E43","E44"],"verdict":"explanation fits the numbers"}}],"rulings":[{"attrs":{"caseId":"1045810_2016-01-31","revisionId":"a8ff0e701965","sampleIndex":2,"rulingIndex":3,"finding_index":3,"ruling":"fits","reason":"Management states inventory provisions increased to $112M in FY2016 from $59M in FY2015, pressuring gross margin (E43, E44). The numbers show COGS rose $117M (E2, E14) and the provision increase of $53M (E43) accounts for a substantial portion of that rise. The Tegra margin decline is attributed to provisions, a warranty charge, and mix shift (E44). The named driver (higher inventory provisions) is visible in the reported numbers and its size is large enough to explain a significant part of the COGS increase.","evidence":["E2","E14","E43","E44"],"rebuttal":{"finding_index":3,"innocent_explanation":"The rise in inventory provisions to $112M (from $59M) directly increased COGS and pressured gross margin, consistent with management's attribution to older Tegra products, SHIELD component excess, and a warranty charge; the COGS increase from $2,082M to $2,199M aligns with this impact.","evidence":["E2","E14","E43","E44"],"support":"numbers"},"final_verdict":"explanation unverified","confidence":0.85}}],"audit":[{"seq":2,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E2 (evidence)","kind":"upsertEntity"},{"seq":20,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E20 (evidence)","kind":"upsertEntity"},{"seq":21,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E21 (evidence)","kind":"upsertEntity"},{"seq":22,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E22 (evidence)","kind":"upsertEntity"},{"seq":23,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E23 (evidence)","kind":"upsertEntity"},{"seq":24,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E24 (evidence)","kind":"upsertEntity"},{"seq":25,"actor":"evidence-pack","summary":"evidence:ingest:1045810_2016-01-31:a8ff0e701965:E25 (evidence)","kind":"upsertEnti